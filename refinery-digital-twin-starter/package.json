{
  "name": "refinery-digital-twin",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "lint": "npm run lint -w app && node scripts/python.mjs -m ruff check pipeline tests",
    "test": "npm run test -w app && node scripts/python.mjs -m pytest && npm run test:visual-tools",
    "validate": "node scripts/python.mjs -m pipeline.validate data/synthetic && node scripts/python.mjs -m pipeline.validate data/normalized",
    "build": "npm run build -w app",
    "check": "npm run normalize && npm run lint && npm test && npm run validate && npm run build",
    "normalize": "node scripts/python.mjs -m pipeline.normalize data/synthetic data/normalized",
    "predev": "npm run normalize",
    "prebuild": "npm run normalize",
    "build:preview": "node scripts/python.mjs -m scripts.build_preview",
    "build:models": "node scripts/python.mjs -m scripts.build_models",
    "check:generators": "node scripts/python.mjs -m scripts.check_generators",
    "start": "node scripts/serve.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "data:verify": "node scripts/data-verify.mjs",
    "shots": "node scripts/shots.mjs",
    "metrics": "node tests/visual/look-metrics.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "test:visual-tools": "node --test tests/visual/*.test.mjs",
    "test:looks": "node tests/visual/look-flow.mjs",
    "optimize:models": "node scripts/optimize-models.mjs"
  },
  "overrides": {
    "vitest": "4.1.11",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "meshoptimizer": "^0.25.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0"
  }
}

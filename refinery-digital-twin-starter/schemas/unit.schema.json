    "unit_id",
    "area_id",
    "name"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "area_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
